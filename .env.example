# 公開URL（metadataBase / Open Graph の絶対URL生成に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 認証デモ（Authentication 章の教材）のセッションに署名する秘密鍵。サーバーでだけ読む。
# 32文字以上のランダムな文字列を設定する（例: openssl rand -base64 32 の出力）。
# 環境（ローカル / Preview / Production）ごとに別の値にし、NEXT_PUBLIC_ を付けないこと。
# 未設定の場合は、認証デモだけが使えなくなる（教材の本文は表示される）。
AUTH_DEMO_SECRET=

# ---- AI 機能（docs/AI_IMPLEMENTATION_PLAN.md）----
# AI 機能の対象は 18 歳以上・日本国内からの利用だけ（Gemini API 規約の条件）。
# どれかが欠けていても、AI 機能だけが使えなくなる（教材・デモはそのまま使える）。
# すべてサーバーでだけ読む。NEXT_PUBLIC_ を付けないこと。

# true のときだけ AI 機能を有効にする
NEXTSCOPE_AI_ENABLED=false
# Google AI Studio で発行した Gemini API キー（請求先アカウントは結び付けない）
GEMINI_API_KEY=
# 無料枠の対象モデルの ID。AI Studio で、無料枠と現在の制限を確認してから設定する
GEMINI_MODEL=
# アプリ側の安全のための上限（Gemini 公式の上限ではない）。日本時間 0 時で区切る
NEXTSCOPE_AI_DAILY_REQUEST_CAP=20
NEXTSCOPE_AI_PER_SOURCE_DAILY_CAP=3
# IP アドレスのハッシュと匿名 Cookie の署名に使う秘密の値（32 文字以上。例: openssl rand -base64 32）
NEXTSCOPE_AI_HASH_SECRET=
# 利用制限とキャッシュの保存先（Upstash Redis の無料プラン。カードは登録しない）。
# 本番では必須（未設定なら AI は無効になる）。開発中は未設定ならメモリで代用する
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
